---
import BaseLayout from '../layouts/BaseLayout.astro';
---
<BaseLayout title="404 | 无奈朝来寒雨的博客" description="页面不存在">
  <section class="not-found">
    <h1 class="gradient-text">404</h1>
    <p>页面不存在,或已被移动。</p>
    <a href="/">← 返回首页</a>
  </section>
</BaseLayout>

<style>
  .not-found {
    padding: 5rem 0;
    text-align: center;
  }
  .not-found h1 {
    font-size: 4rem;
    margin-bottom: 0.25em;
  }
  .not-found p {
    color: var(--text-dim);
  }
</style>
