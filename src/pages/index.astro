---
import { getCollection } from 'astro:content';
import BaseLayout from '../layouts/BaseLayout.astro';
import PostCard from '../components/PostCard.astro';

const posts = (await getCollection('posts')).sort(
  (a, b) => b.data.pubDate.valueOf() - a.data.pubDate.valueOf()
);
---
<BaseLayout title="无奈朝来寒雨的博客" description="技术文章、学习笔记与项目记录。">
  <section class="hero">
    <h1>Hi, 我是 <span class="gradient-text">无奈朝来寒雨</span></h1>
    <p>技术文章、学习笔记与项目记录。</p>
  </section>

  <section class="posts">
    {posts.map((post) => (
      <PostCard
        title={post.data.title}
        description={post.data.description}
        pubDate={post.data.pubDate}
        tags={post.data.tags}
        href={`/posts/${post.slug}`}
      />
    ))}
  </section>
</BaseLayout>

<style>
  .hero {
    padding: 3rem 0 2rem;
  }
  .hero h1 {
    font-size: 2.2rem;
  }
  .hero p {
    color: var(--text-dim);
  }
  .posts {
    display: flex;
    flex-direction: column;
    gap: 1rem;
    padding-bottom: 2rem;
  }
</style>
