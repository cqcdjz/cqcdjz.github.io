---
import { getCollection } from 'astro:content';
import BaseLayout from '../layouts/BaseLayout.astro';

const projects = await getCollection('projects');
---
<BaseLayout title="项目 | 无奈朝来寒雨的博客" description="项目展示">
  <section class="page">
    <h1>项目</h1>
    <div class="grid">
      {projects.map((p) => (
        <article class="glass-card project">
          <h2>{p.data.title}</h2>
          <p class="desc">{p.data.description}</p>
          <div class="tech">
            {p.data.tech.map((t) => <span class="tag">{t}</span>)}
          </div>
          {p.data.link && (
            <a class="link" href={p.data.link} target="_blank" rel="noopener">查看 →</a>
          )}
        </article>
      ))}
    </div>
  </section>
</BaseLayout>

<style>
  .page {
    padding: 2.5rem 0 3rem;
  }
  .grid {
    display: grid;
    grid-template-columns: repeat(auto-fill, minmax(240px, 1fr));
    gap: 1rem;
  }
  .project {
    padding: 1.4rem;
  }
  .project h2 {
    font-size: 1.15rem;
  }
  .desc {
    color: var(--text-dim);
    font-size: 0.9rem;
  }
  .tech {
    margin: 0.8rem 0;
  }
  .link {
    font-size: 0.9rem;
  }
</style>
